{
    "name": "infrangible/m2-smtp",
    "description": "Sends all store emails through your own SMTP servers, with a backup server, an automatic fallback, test mails and a log of every sent email.",
    "type": "magento2-module",
    "version": "1.3.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Email",
        "Integrations",
        "SMTP email",
        "send emails via SMTP",
        "email log"
    ],
    "homepage": "https://github.com/infrangible/m2-smtp",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.5|~103.0.0",
        "infrangible/m2-backend-widget": "~2.7.0",
        "infrangible/m2-simple-mail": "~1.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Smtp\\": "src"
        }
    }
}
